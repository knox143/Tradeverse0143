# ==============================================================================
# TradeVerse Environment Configuration
# ==============================================================================
# Copy this file to .env (for local development) or configure in Vercel:
# Vercel Dashboard -> Project -> Settings -> Environment Variables.
#
# NOTE ON FREE APIS & 10–15 MINUTE PRICE DELAY:
# Free market feeds (Yahoo Finance, Binance public, CoinGecko demo, Finnhub free)
# provide market data with a standard 10–15 minute exchange delay.
# This is normal for free-tier market data and suitable for paper trading practice.
# ==============================================================================

# 1. Flask Secret Key (Required for signed session & account vault cookies)
TRADEVERSE_SECRET_KEY=tradeverse-secure-session-key-2026-production

# 2. CoinGecko API Key (Live crypto quotes & OHLC candlestick charts)
COINGECKO_API_KEY=CG-MVjPXU83MGtQ1BHYdjXmcAXZ

# 3. Finnhub API Key (Live US stock & crypto quotes)
FINNHUB_API_KEY=db17ushr01qhkqh8lr2gdb17ushr01qhkqh8lr30

# 4. Twelve Data API Key (Live stock time series & quotes)
TWELVE_DATA_API_KEY=a39be725ae064a3584d9be4d2fb8460e

# 5. Market Price Cache TTL in seconds (Default: 60)
PRICE_CACHE_TTL_SECONDS=60

# 6. HTTP Request Timeout in seconds (Default: 10)
REQUEST_TIMEOUT_SECONDS=10

# 7. Gmail SMTP Configuration for 4-Digit OTP Signup Verification (Optional / Recommended)
# If left blank, the app will run in Developer Mode and display/log the OTP directly.
# To send LIVE verification emails to user Gmail inboxes:
# - SMTP_USER: Your full Gmail address (e.g. yourname@gmail.com)
# - SMTP_PASS: Your 16-character Google App Password (generate at: https://myaccount.google.com/apppasswords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 8. Redis Cache URL (Local or Cloud Upstash Redis)
# Resolves external API rate limits (Twelve Data, CoinGecko, Binance) and boosts quote/candle speeds to <20ms.
# Local Redis:
REDIS_URL=redis://localhost:6379/0
# Upstash Cloud Redis (Recommended for Vercel / Cloud Deployments):
# REDIS_URL=rediss://default:your_upstash_password@your_endpoint.upstash.io:6379
