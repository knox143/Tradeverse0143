# ==============================================================================
# TradeVerse Environment Configuration
# ==============================================================================
# Copy this file to .env (for local development) or configure in Vercel:
# Vercel Dashboard -> Project -> Settings -> Environment Variables.
#
# NOTE ON FREE APIS & 10–15 MINUTE PRICE DELAY:
# Free market feeds (Yahoo Finance, Binance public, CoinGecko demo, Finnhub free)
# provide market data with a standard 10–15 minute exchange delay.
# This is normal for free-tier market data and suitable for paper trading practice.
# ==============================================================================

# 1. Flask Secret Key (Required for signed session & account vault cookies)
TRADEVERSE_SECRET_KEY=tradeverse-secure-session-key-2026-production

# 2. CoinGecko API Key (Optional - Crypto quote fallback)
# Get a FREE Demo API Key: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# 3. Finnhub API Key (Optional - Global stock quotes fallback)
# Get a FREE API Key (60 calls/min): https://finnhub.io
FINNHUB_API_KEY=

# 4. Twelve Data API Key (Optional - Indian & Global stock backup)
# Get a FREE API Key (8 calls/min): https://twelvedata.com
TWELVE_DATA_API_KEY=

# 5. Market Price Cache TTL in seconds (Default: 60)
PRICE_CACHE_TTL_SECONDS=60

# 6. HTTP Request Timeout in seconds (Default: 10)
REQUEST_TIMEOUT_SECONDS=10
