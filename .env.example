# TradeVerse Environment Configuration Example
# Copy this file to .env and adjust the values as needed.

# Flask secret key for user sessions
TRADEVERSE_SECRET_KEY=replace_with_a_secure_random_string

# Market Price Cache TTL (seconds, default: 60)
PRICE_CACHE_TTL_SECONDS=60

# HTTP Request Timeout for market feeds (seconds, default: 10)
REQUEST_TIMEOUT_SECONDS=10

# Optional API keys (public unauthenticated fallbacks are available if omitted)
COINGECKO_API_KEY=your_coingecko_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
